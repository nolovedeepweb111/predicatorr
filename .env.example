# Скопируйте в .env и поправьте. Пустые строки и комментарии игнорируются.
PREDICATOR_HOST=127.0.0.1
PREDICATOR_PORT=8000
# Пароль на сайт (HTTP Basic, имя пользователя любое). Обязательно, если сайт виден из интернета.
PREDICATOR_PASSWORD=
# Как часто обновлять данные в фоне, минут (0 — только по кнопке).
PREDICATOR_SYNC_MINUTES=15
# Опрашивать API mixer-cup для свежих составов и расписания.
PREDICATOR_MIXER_LIVE=1
# Загружать линию PARI (0 — коэффициенты только вручную).
PARI_ENABLED=1
