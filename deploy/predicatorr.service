[Unit]
Description=Predicatorr — прогнозы на Dota-миксеры
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/predicatorr
ExecStart=/opt/predicatorr/.venv/bin/python -m predicator serve
Restart=on-failure
RestartSec=5
# Владелец /opt/predicatorr (база лежит в /opt/predicatorr/var); README подставляет его сам
User=predicatorr

[Install]
WantedBy=multi-user.target
